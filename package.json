{
  "name": "scorgen-plus",
  "private": true,
  "version": "1.0.0",
  "description": "A sight-reading trainer for musicians",
  "homepage": "https://felixguitarra.github.io/Scorgen-Plus",
  "author": "Scorgen Team",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "electron:build-ts": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"npm run electron:build-ts && wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && npm run electron:build-ts && electron-builder"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.scorgen.pro",
    "productName": "Scorgen Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src/data/rhythmTemplates.json",
        "to": "rhythmTemplates.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "Scorgen.PNG"
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tonal": "^6.4.2",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  }
}
